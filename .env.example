# ── SMART on FHIR / OAuth2 ───────────────────────────────────────────
FHIR_ISS=https://launch.smarthealthit.org/v/r4/fhir
SMART_CLIENT_ID=patient-journey-poc
SMART_REDIRECT_URI=http://localhost:3000/api/auth/callback
SMART_SCOPES=launch openid fhirUser patient/*.read offline_access
SESSION_SECRET=please_change_me_to_a_long_random_secret_min_32

# ── ⑤ AI 服務 ────────────────────────────────────────────────────────
# Anthropic Claude API key（伺服端，永不暴露給前端）
# 取得：https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# 前端 base URL（BFF 內部呼叫用）
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── SMART on FHIR / OAuth2 ───────────────────────────────────────────
FHIR_ISS=https://launch.smarthealthit.org/v/r4/fhir
SMART_CLIENT_ID=patient-journey-poc
SMART_REDIRECT_URI=http://localhost:3000/api/auth/callback
SMART_SCOPES=launch openid fhirUser patient/*.read offline_access

# 至少 32 字元隨機字串（生產環境若未設定，系統拒絕啟動）
SESSION_SECRET=please_change_me_to_a_long_random_secret_min_32

# ── CDS Hooks CORS ───────────────────────────────────────────────────
# 允許呼叫 CDS Hooks 的 EHR origin（逗號分隔）
# 開發環境可用 *；生產環境應填入 HIS domain，例如：
# ALLOWED_EHR_ORIGINS=https://his.hospital.com.tw,https://ehr.hospital.com.tw
ALLOWED_EHR_ORIGINS=*

# ── AI 服務 ──────────────────────────────────────────────────────────
# LLM 提供者切換：gemini | claude | deepseek（預設 gemini）
LLM_PROVIDER=gemini

# Google Gemini（LLM_PROVIDER=gemini 時需設定；金鑰沿用 care_rag_api 慣例 GOOGLE_API_KEY）
# 取得方式：https://aistudio.google.com/
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxx
# 模型名稱（預設 gemini-2.5-flash；可選 gemini-2.5-pro / gemini-flash-latest。
# 注意 gemini-2.0-flash 已停用會回 404，請用 2.5+ 系列）
GEMINI_MODEL_NAME=gemini-2.5-flash

# Anthropic Claude API key（LLM_PROVIDER=claude 時需設定）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# DeepSeek API key（LLM_PROVIDER=deepseek 時需設定）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxx

# 前端 base URL（本機開發用）
NEXT_PUBLIC_BASE_URL=http://localhost:3000
